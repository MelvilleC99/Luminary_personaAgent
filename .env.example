# Updated .env file for Luminary Persona Agent
# Replace with your actual values

# Database Configuration
SUPABASE_URL=https://hqebikhopnsbacmpahmx.supabase.co
SUPABASE_KEY=your_anon_key_here_replace_this
SUPABASE_SERVICE_KEY=your_service_key_here_replace_this

# LLM API Keys
OPENAI_API_KEY=sk-your_openai_key_here_replace_this
ANTHROPIC_API_KEY=your_anthropic_api_key  # Not needed if using only OpenAI
DEEPSEEK_API_KEY=your_deepseek_api_key    # Not needed if using only OpenAI

# LLM Assignments (using only OpenAI as requested)
QUESTION_AGENT_LLM=openai
ASSESSMENT_AGENT_LLM=openai
SCRAPER_AGENT_LLM=openai
PERSONA_AGENT_LLM=openai

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
MAX_FOLLOW_UPS=3
ASSESSMENT_THRESHOLD=7.0

# API Configuration
API_HOST=localhost
API_PORT=8000

# Session Management
SESSION_TIMEOUT_HOURS=24

# Redis Configuration (Required for enhanced memory management)
REDIS_URL=redis://localhost:6379

# Memory Management Settings
MAX_CONTEXT_TOKENS=3000
RECENT_MESSAGE_LIMIT=10
