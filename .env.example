# Environment Variables Template

# Database Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# LLM Assignments (which LLM to use for which agent)
QUESTION_AGENT_LLM=openai
ASSESSMENT_AGENT_LLM=deepseek
SCRAPER_AGENT_LLM=openai
PERSONA_AGENT_LLM=claude

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
MAX_FOLLOW_UPS=3
ASSESSMENT_THRESHOLD=7.0

# API Configuration
API_HOST=localhost
API_PORT=8000

# Session Management
SESSION_TIMEOUT_HOURS=24
REDIS_URL=redis://localhost:6379  # Optional, for future use
